# Kard Radar configuration. Copy to .env (or run: python server.py --init) and fill in what you need.
# .env is git-ignored. Never put these values in frontend code.

# --- Required: admin login ---------------------------------------------------
# ADMIN_PASSWORD=choose-a-long-password
# SESSION_SECRET=64-random-hex-characters   (python -c "import secrets; print(secrets.token_hex(32))")
# Set to 1 when served over HTTPS in production so the session cookie is Secure-only.
SECURE_COOKIES=0

# --- Database ------------------------------------------------------------------
# Default: SQLite file at data/kard_radar.db. For Postgres/Supabase set DATABASE_URL (needs: pip install "psycopg[binary]").
# KARD_DB_PATH=data/kard_radar.db
# DATABASE_URL=postgresql://user:password@host:5432/kard_radar

# --- AI analysis (optional) -----------------------------------------------------
# Enables AI business analysis + AI outreach drafts. Rule-based scoring works without it.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5        # claude-sonnet-5 is cheaper
# AI_EFFORT=medium                     # low | medium | high | xhigh | max

# --- Lead discovery providers (optional; any one enables search discovery) -------
# SERPER_API_KEY=                      # https://serper.dev — Google results (web, site:instagram.com, site:tiktok.com)
# BRAVE_SEARCH_API_KEY=                # https://brave.com/search/api/ — used if Serper is not set
# GOOGLE_PLACES_API_KEY=               # Google Places API (New) — restaurants, hotels, venues with phone/website
